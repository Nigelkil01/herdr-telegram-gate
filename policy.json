{
  "version": "0.1.0",
  "workspace_root": "~/projects",
  "approval_ttl_seconds": 300,
  "defaults": {
    "tier": 2
  },
  "rules": [
    {
      "id": "manual-git-push",
      "tier": 2,
      "manual": true,
      "description": "git push/merge/release are always human-approved",
      "match": { "argv": ["git", "push"] }
    },
    {
      "id": "manual-git-merge",
      "tier": 2,
      "manual": true,
      "description": "git merge is always human-approved",
      "match": { "argv": ["git", "merge"] }
    },
    {
      "id": "manual-rm",
      "tier": 2,
      "manual": true,
      "description": "rm is always human-approved",
      "match": { "argv": ["rm"] }
    }
  ]
}
